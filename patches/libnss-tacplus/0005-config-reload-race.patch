+/*
+ * NuDanOS: the configuration (server table, keys, timeout, source address)
+ * is re-read whenever the file changes, from any thread. Parsing takes
+ * config_lock for writing; each entry point then works under it for
+ * reading (WITH_CONFIG), so a reload cannot free a key or clear an address
+ * another thread is using. config_held marks a thread inside an entry
+ * point: its own get_config() call returns the result parsed just before.
+ */
+static pthread_rwlock_t config_lock = PTHREAD_RWLOCK_INITIALIZER;
+static __thread int config_held;
+static int config_result, config_errno;
 
 static int
 get_config(int *errp, int level)
 {
-    int result;
+    int result, err = 0;
 
-    /* NuDanOS: the parser rewrites the server tables; callers may be
