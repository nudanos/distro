+    config_result = result;
+    config_errno = err;
+    pthread_rwlock_unlock(&config_lock);
+    if (err && errp)
+        *errp = err;
 
     /* no config file, no servers, etc.
      * this is a debug because privileges may not allow access
@@ -369,6 +386,18 @@ get_config(int *errp, int level)
     return result;
 }
 
+#define WITH_CONFIG(call) do {                                  \
+        int with_err = 0;                                       \
+        enum nss_status with_status;                            \
+        (void)get_config(&with_err, 1);                         \
+        pthread_rwlock_rdlock(&config_lock);                    \
+        config_held = 1;                                        \
+        with_status = (call);                                   \
+        config_held = 0;                                        \
+        pthread_rwlock_unlock(&config_lock);                    \
+        return with_status;                                     \
+    } while (0)
+
 
