diff --git a/test/config_threads.c b/test/config_threads.c
new file mode 100644
index 0000000..56d2ee2
--- /dev/null
+++ b/test/config_threads.c
@@ -0,0 +1,126 @@
+/*
+ * NuDanOS: a long-lived multithreaded caller (configd) resolves TACACS+
+ * users from many threads while the configuration file can change (a commit
+ * of "system login tacplus-server"). Every entry point re-reads a changed
+ * file: reset_config() freed each server's key and cleared its address
+ * while another thread was in lookup_tacacs_user() using them. Lookups must
+ * survive configuration reloads.
+ *
+ * Built from nss_tacplus.c itself so the test can point it at its own
+ * configuration file. A listener on 127.0.0.1 accepts every connection and
+ * discards what it reads, so each lookup goes on to send a request
+ * encrypted with the server's key. Built with AddressSanitizer: a key freed
+ * by a reload while a lookup uses it fails the test.
+ */
+#include "../nss_tacplus.c"
+
+#include <netinet/in.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+
+/*
+ * Leak checking is off: reset_config() drops each server's getaddrinfo()
+ * result without freeing it (upstream, before NuDanOS), and this test
+ * reloads thousands of times. Use-after-free and other errors still fail it.
+ */
+const char *__asan_default_options(void);
+const char *__asan_default_options(void)
+{
+    return "detect_leaks=0";
+}
+
+#define READERS 6
+#define ROUNDS 2000
+
+static char conf[] = "/tmp/tacplus_nss_cfgXXXXXX";
+static atomic_int readers_done;
+static int port;
+
+/* accept and drain connections: a TACACS+ server that never answers */
+static void *listener(void *arg)
+{
+    int ls = *(int *)arg;
+
+    for (;;) {
+        char b[512];
+        int c = accept(ls, NULL, NULL);
+        if (c < 0)
+            return NULL;
+        (void)!read(c, b, sizeof b);
+        close(c);
+    }
+}
+
+static void *lookup(void *arg)
+{
+    char buf[4096];
+    struct passwd pw;
+    int err, i;
+
+    (void)arg;
+    for (i = 0; i < ROUNDS; i++)
+        (void)_nss_tacplus_getpwnam_r("tacuser", &pw, buf, sizeof buf, &err);
+    atomic_fetch_add(&readers_done, 1);
+    return NULL;
+}
+
+/* write the configuration under a new inode: the next lookup re-parses */
+static void *rewrite(void *arg)
+{
+    char tmp[sizeof conf + 4];
+    unsigned n = 0;
+
+    (void)arg;
+    snprintf(tmp, sizeof tmp, "%s.new", conf);
+    while (atomic_load(&readers_done) < READERS) {
+        FILE *f = fopen(tmp, "w");
+        if (!f)
+            break;
+        fprintf(f, "timeout=1\nsecret=key-%u\nserver=127.0.0.1:%d\n"
+                   "secret=other-%u\nserver=127.0.0.1:%d\n", n, port, n, port);
+        fclose(f);
+        rename(tmp, conf);
+        n++;
+    }
+    unlink(tmp);
+    return (void *)(long)n;
+}
+
+int main(void)
+{
+    pthread_t r[READERS], w, l;
+    void *reloads;
+    struct sockaddr_in sa = {.sin_family = AF_INET,
+                             .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    socklen_t salen = sizeof sa;
+    int ls = socket(AF_INET, SOCK_STREAM, 0), fd, i;
+
+    if (ls < 0 || bind(ls, (struct sockaddr *)&sa, sizeof sa) ||
+        listen(ls, 64) || getsockname(ls, (struct sockaddr *)&sa, &salen)) {
+        perror("listener");
+        return 2;
+    }
+    port = ntohs(sa.sin_port);
+    pthread_create(&l, NULL, listener, &ls);
+
+    fd = mkstemp(conf);
+    if (fd < 0 || dprintf(fd, "secret=test\nserver=127.0.0.1:%d\n", port) < 0) {
+        perror("config");
+        return 2;
+    }
+    close(fd);
+    config_file = conf;
+
+    pthread_create(&w, NULL, rewrite, NULL);
+    for (i = 0; i < READERS; i++)
+        pthread_create(&r[i], NULL, lookup, NULL);
+    for (i = 0; i < READERS; i++)
+        pthread_join(r[i], NULL);
+    pthread_join(w, &reloads);
+    unlink(conf);
+    printf("config_threads: OK, %d lookups in %d threads across %ld rewrites\n",
+           READERS * ROUNDS, READERS, (long)reloads);
+    return 0;
+}
