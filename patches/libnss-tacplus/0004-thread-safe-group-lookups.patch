Description: thread-safe group lookups by name and gid
 getgrnam_r and getgrgid_r read /etc/group through fgetgrent(), whose
 static buffer every thread shares, and through the per-thread enumeration
 stream. configd (group.LookupUid -> getgrgid_r, from many goroutines)
 still died with SIGSEGV after 0003. Each lookup now opens /etc/group and
 reads it with fgetgrent_r into a buffer of its own. test/grent_threads
 runs lookups alongside the enumerations; it failed three runs of three
 before this change and passes after.
Author: NuDanOS Maintainers <jon@fernandez.tech>
Forwarded: no
Last-Update: 2026-10-11
---
diff --git a/nss_tacplus.c b/nss_tacplus.c
index 20c562d..b470d4d 100644
--- a/nss_tacplus.c
+++ b/nss_tacplus.c
@@ -1367,6 +1367,57 @@ enum nss_status _nss_tacplus_getgrent_r(struct group *gr_result,
     return ret;
 }
 
+/*
+ * NuDanOS: find one group (by name, or by gid when name is NULL) with a
+ * stream and buffer of its own: fgetgrent()'s static buffer and the
+ * per-thread enumeration stream are not the lookup's to use, and configd
+ * calls getgrgid_r from many threads at once.
+ */
+static enum nss_status find_group(const char *name, gid_t gid,
+                                  struct group *gr, char *buffer,
+                                  size_t buflen, int *errnop)
+{
+    enum nss_status status = NSS_STATUS_NOTFOUND;
+    struct group tmp, *ent;
+    size_t len = 4096;
+    char *buf = malloc(len);
+    FILE *f = fopen("/etc/group", "re");
+    int localerr, r;
+
+    if (!buf || !f) {
+        free(buf);
+        if (f)
+            fclose(f);
+        return NSS_STATUS_UNAVAIL;
+    }
+    for (;;) {
+        r = fgetgrent_r(f, &tmp, buf, len, &ent);
+        if (r == ERANGE) {
+            char *bigger = realloc(buf, len * 2);
+            if (!bigger) {
+                if (errnop)
+                    *errnop = ENOMEM;
+                status = NSS_STATUS_TRYAGAIN;
+                break;
+            }
+            buf = bigger;
+            len *= 2;
+            continue;
+        }
+        if (r || !ent)
+            break;
+        if (name ? !strcmp(ent->gr_name, name) : ent->gr_gid == gid) {
+            status = fixup_grent(ent, gr, buffer, buflen, &localerr);
+            if (errnop)
+                *errnop = localerr;
+            break;
+        }
+    }
+    fclose(f);
+    free(buf);
+    return status;
+}
+
 __attribute__((visibility("default")))
 enum nss_status _nss_tacplus_getgrnam_r(const char *name, struct group *gr,
                                         char *buffer, size_t buflen,
@@ -1374,8 +1425,6 @@ enum nss_status _nss_tacplus_getgrnam_r(const char *name, struct group *gr,
 {
     enum nss_status status = NSS_STATUS_NOTFOUND;
     int ret;
-    struct group *ent;
-    int localerr;
 
     if (!gr) {
         if (errnop)
@@ -1387,19 +1436,7 @@ enum nss_status _nss_tacplus_getgrnam_r(const char *name, struct group *gr,
     if(ret)
         return errnop && *errnop == ENOENT ? NSS_STATUS_UNAVAIL : status;
 
-    if (_nss_tacplus_setgrent() != NSS_STATUS_SUCCESS)
-        return status;
-
-    for (ent = fgetgrent(grent); ent; ent = fgetgrent(grent)) {
-        if (!strcmp(ent->gr_name, name)) {
-            status = fixup_grent(ent, gr, buffer, buflen, &localerr);
-            if (errnop)
-                *errnop = localerr;
-            break;
-        }
-    }
-
-    return status;
+    return find_group(name, 0, gr, buffer, buflen, errnop);
 }
 
 __attribute__((visibility("default")))
@@ -1409,8 +1446,6 @@ enum nss_status _nss_tacplus_getgrgid_r(gid_t gid, struct group *gr,
 {
     int ret;
     enum nss_status status = NSS_STATUS_NOTFOUND;
-    struct group *ent;
-    int localerr;
 
     if (!gr) {
         if (errnop)
@@ -1422,17 +1457,5 @@ enum nss_status _nss_tacplus_getgrgid_r(gid_t gid, struct group *gr,
     if(ret)
         return errnop && *errnop == ENOENT ? NSS_STATUS_UNAVAIL : status;
 
-    if (_nss_tacplus_setgrent() != NSS_STATUS_SUCCESS)
-        return status;
-
-    for (ent = fgetgrent(grent); ent; ent = fgetgrent(grent)) {
-        if (ent->gr_gid == gid) {
-            status = fixup_grent(ent, gr, buffer, buflen, &localerr);
-            if (errnop)
-                *errnop = localerr;
-            break;
-        }
-    }
-
-    return status;
+    return find_group(NULL, gid, gr, buffer, buflen, errnop);
 }
diff --git a/test/grent_threads.c b/test/grent_threads.c
index df1e5bd..9652986 100644
--- a/test/grent_threads.c
+++ b/test/grent_threads.c
@@ -35,6 +35,27 @@ static void *enumerate(void *arg)
     return (void *)seen;
 }
 
+/* lookups by name and gid run alongside the enumerations (configd's
+ * group.LookupUid -> getgrgid_r crashed the same way) */
+static void *lookup(void *arg)
+{
+    char buf[16384];
+    struct group gr;
+    int err, rounds;
+    long found = 0;
+
+    (void)arg;
+    for (rounds = 0; rounds < ROUNDS; rounds++) {
+        if (_nss_tacplus_getgrgid_r(65534, &gr, buf, sizeof buf, &err) ==
+            NSS_STATUS_SUCCESS)
+            found++;
+        if (_nss_tacplus_getgrnam_r("no-such-group", &gr, buf, sizeof buf, &err) ==
+            NSS_STATUS_SUCCESS)
+            found++;
+    }
+    return (void *)found;
+}
+
 int main(void)
 {
     char conf[] = "/tmp/tacplus_nss_testXXXXXX";
@@ -50,14 +71,14 @@ int main(void)
     config_file = conf;
 
     for (i = 0; i < THREADS; i++)
-        pthread_create(&t[i], NULL, enumerate, NULL);
+        pthread_create(&t[i], NULL, i % 2 ? lookup : enumerate, NULL);
     for (i = 0; i < THREADS; i++) {
         void *seen;
         pthread_join(t[i], &seen);
         total += (long)seen;
     }
     unlink(conf);
-    if (total == 0) {
+    if (total == 0) {  /* enumerations and gid 65534 (nogroup) find entries */
         fprintf(stderr, "grent_threads: no group entries read\n");
         return 1;
     }
