diff --git a/test/grent_threads.c b/test/grent_threads.c
new file mode 100644
index 0000000..df1e5bd
--- /dev/null
+++ b/test/grent_threads.c
@@ -0,0 +1,66 @@
+/*
+ * NuDanOS: glibc's getgrouplist() and initgroups() walk an NSS module's
+ * group entries with setgrent/getgrent_r/endgrent, from whatever thread
+ * calls them. configd calls getgrouplist() from many goroutines at once;
+ * with one static FILE for every thread, one thread's endgrent closed the
+ * stream another was reading and configd died with SIGSEGV, taking every
+ * configuration session with it. Concurrent enumerations must be safe.
+ *
+ * Built from nss_tacplus.c itself so the test can point it at its own
+ * configuration file.
+ */
+#include "../nss_tacplus.c"
+
+#include <pthread.h>
+#include <stdlib.h>
+
+#define THREADS 8
+#define ROUNDS 3000
+
+static void *enumerate(void *arg)
+{
+    char buf[16384];
+    struct group gr;
+    int err, rounds = 0;
+    long seen = 0;
+
+    (void)arg;
+    for (rounds = 0; rounds < ROUNDS; rounds++) {
+        _nss_tacplus_setgrent();
+        while (_nss_tacplus_getgrent_r(&gr, buf, sizeof buf, &err) ==
+               NSS_STATUS_SUCCESS)
+            seen++;
+        _nss_tacplus_endgrent();
+    }
+    return (void *)seen;
+}
+
+int main(void)
+{
+    char conf[] = "/tmp/tacplus_nss_testXXXXXX";
+    pthread_t t[THREADS];
+    long total = 0;
+    int fd = mkstemp(conf), i;
+
+    if (fd < 0 || dprintf(fd, "secret=test\nserver=127.0.0.1\n") < 0) {
+        perror("config");
+        return 2;
+    }
+    close(fd);
+    config_file = conf;
+
+    for (i = 0; i < THREADS; i++)
+        pthread_create(&t[i], NULL, enumerate, NULL);
+    for (i = 0; i < THREADS; i++) {
+        void *seen;
+        pthread_join(t[i], &seen);
+        total += (long)seen;
+    }
+    unlink(conf);
+    if (total == 0) {
+        fprintf(stderr, "grent_threads: no group entries read\n");
+        return 1;
+    }
+    printf("grent_threads: OK, %ld entries in %d threads\n", total, THREADS);
+    return 0;
+}
