diff --git a/keepalived/vrrp/vrrp_parser.c b/keepalived/vrrp/vrrp_parser.c
index 56e04b03..ea376d67 100644
--- a/keepalived/vrrp/vrrp_parser.c
+++ b/keepalived/vrrp/vrrp_parser.c
@@ -637,6 +637,15 @@ vrrp_vmac_xmit_base_handler(__attribute__((unused)) const vector_t *strvec)
 {
 	__set_bit(VRRP_VMAC_XMITBASE_BIT, &current_vrrp->flags);
 }
+#ifdef _HAVE_VRF_
+static void
+vrrp_vmac_vrf_aware_handler(__attribute__((unused)) const vector_t *strvec)
+{
+	vrrp_t *vrrp = list_last_entry(&vrrp_data->vrrp, vrrp_t, e_list);
+
+	vrrp->vrf_aware = true;
+}
+#endif
 #endif
 #ifdef _HAVE_VRRP_IPVLAN_
 static void
@@ -2350,6 +2359,9 @@ init_vrrp_keywords(bool active)
 	install_keyword("use_vmac", &vrrp_vmac_handler);
 	install_keyword("use_vmac_addr", &vrrp_vmac_addr_handler);
 	install_keyword("vmac_xmit_base", &vrrp_vmac_xmit_base_handler);
+#ifdef _HAVE_VRF_
+	install_keyword("vrf_aware", &vrrp_vmac_vrf_aware_handler);
+#endif
 #endif
 #ifdef _HAVE_VRRP_IPVLAN_
 	install_keyword("use_ipvlan", &vrrp_ipvlan_handler);
diff --git a/keepalived/vrrp/vrrp_vmac.c b/keepalived/vrrp/vrrp_vmac.c
index a61c9c24..836f156d 100644
--- a/keepalived/vrrp/vrrp_vmac.c
+++ b/keepalived/vrrp/vrrp_vmac.c
@@ -444,8 +444,12 @@ netlink_link_add_vmac(vrrp_t *vrrp, const interface_t *old_interface)
 #ifdef _HAVE_VRF_
 		/* If the underlying interface is enslaved to a VRF master, then this
 		 * interface should be as well. */
-		if (vrrp->configured_ifp->vrf_master_ifp || update_interface)
-			addattr32(&req.n, sizeof(req), IFLA_MASTER, vrrp->configured_ifp->vrf_master_ifp ? vrrp->configured_ifp->vrf_master_ifp->ifindex : 0);
+		/* Vyatta: only a vrf_aware instance puts its VMAC in the base interface's
