+/*
+ * Vyatta endpoints name their routing instance last: [<address>:]<port>:<vrf>
+ * (DANOS agentaddress and trap sink syntax). Split the VRF off so it can be
+ * handled as <address>@<vrf>:<port>; binding to the VRF master device is what
+ * the interface form does. Returns the VRF and truncates @str before it, or
+ * returns NULL and leaves @str untouched when it is not in that form.
+ */
+static char *netsnmp_split_vrf(char *str)
+{
+    char *start = str, *last, *prev;
+
+    if (strchr(str, '@'))
+        return NULL;
+    if (*start == '[') {
+        start = strchr(start, ']');
+        if (!start)
+            return NULL;
+    }
+    last = strrchr(start, ':');
+    if (!last || last[1] == '\0')
+        return NULL;
+    *last = '\0';
+    prev = strrchr(start, ':');
+    if (prev ? (prev[1] != '\0' && netsnmp_isnumber(prev + 1) &&
+                strchr(start, ':') == prev)
+             : (str[0] != '\0' && netsnmp_isnumber(str)))
+        return last + 1;
+    *last = ':';
+    return NULL;
+}
