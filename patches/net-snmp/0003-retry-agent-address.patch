+            return 0;
+        }
+        DEBUGMSGTL(("snmp_agent",
+                    "init_master_agent; registered alarm %u for retry agent address\n",
+                    retry_addr->alarm_id));
+    }
 #endif /* NETSNMP_NO_LISTEN_SUPPORT */
 
