+/**
+ * @internal
+ * Name the L3 VRF the interface belongs to, so its link notifications are
+ * sent in that VRF's context. Follows master links (a bridge or bond member
+ * is enslaved to the bridge, which is enslaved to the VRF) until a device of
+ * type vrf is found. Leaves entry->vrf empty in the default VRF.
+ */
+static void
+_arch_interface_vrf_get(netsnmp_interface_entry *entry)
+{
+    char            dev[sizeof(entry->vrf)], path[128], link[128], line[64];
+    const char     *base;
+    FILE           *fin;
+    ssize_t         len;
+    int             depth, is_vrf;
+
+    entry->vrf[0] = '\0';
+    strlcpy(dev, entry->name, sizeof(dev));
+    for (depth = 0; depth < 4; depth++) {
+        snprintf(path, sizeof(path), "/sys/class/net/%s/master", dev);
+        len = readlink(path, link, sizeof(link) - 1);
+        if (len <= 0)
+            return;
+        link[len] = '\0';
+        base = strrchr(link, '/');
+        base = base ? base + 1 : link;
+        strlcpy(dev, base, sizeof(dev));
+
+        snprintf(path, sizeof(path), "/sys/class/net/%s/uevent", dev);
+        if (!(fin = fopen(path, "r")))
+            return;
+        is_vrf = 0;
+        while (fgets(line, sizeof(line), fin))
+            if (strcmp(line, "DEVTYPE=vrf\n") == 0)
+                is_vrf = 1;
+        fclose(fin);
+        if (is_vrf) {
+            strlcpy(entry->vrf, dev, sizeof(entry->vrf));
+            DEBUGMSGTL(("access:interface", "%s is in vrf %s\n",
+                        entry->name, entry->vrf));
+            return;
+        }
+    }
+}
+
 /**
  * @internal
  */
@@ -892,6 +937,8 @@ netsnmp_arch_interface_container_load(netsnmp_container* container,
         } else {
             netsnmp_access_interface_entry_guess_speed(entry);
         }
+
+        _arch_interface_vrf_get(entry);
         
         netsnmp_access_interface_ioctl_flags_get(fd, entry);
 
