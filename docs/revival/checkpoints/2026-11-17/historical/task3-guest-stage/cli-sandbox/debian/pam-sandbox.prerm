#! /bin/sh -e

if [ "$1" = remove ]; then
    DEBIAN_FRONTEND=noninteractive pam-auth-update --disable sandbox
    test -r /etc/pam.d/common-session
    if grep -Eq '^[[:space:]]*-?session[[:space:]]+[^#]*[[:space:]/]pam_sandbox\.so([[:space:]]|$)' /etc/pam.d/common-session; then
        echo 'PAM still loads pam_sandbox.so; remove the local session rule before uninstalling' >&2
        exit 1
    fi
    profile=/usr/share/pam-configs/sandbox
    if cmp -s /opt/vyatta/share/pam-configs/sandbox "$profile"; then
        rm -f "$profile"
    fi
fi

#DEBHELPER#

exit 0
